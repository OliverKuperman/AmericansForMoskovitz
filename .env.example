# Server
PORT=3000
SITE_URL=https://yourdomain.com

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moskovitz_petition
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Set to "true" only when connecting to a remote DB over SSL
DB_SSL=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Used to send email verification links when someone submits the petition.
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_ADDRESS="Americans for Moskovitz <noreply@yourdomain.com>"
