# Server
PORT=3000
SITE_URL=https://yourdomain.com

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moskovitz_petition
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Set to "true" only when connecting to a remote DB over SSL
DB_SSL=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Used to send email verification links when someone submits the petition.
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_ADDRESS="Americans for Moskovitz <noreply@yourdomain.com>"

# ── Email fallback (MailerSend) ──────────────────────────────────────────────
# Used automatically if Resend fails. Get an API key at https://app.mailersend.com
# and verify your sending domain there.
MAILERSEND_API_KEY=your-mailersend-api-key

# ── Webhook signing secrets ──────────────────────────────────────────────────
# A signature is counted when the provider reports the mail was delivered, and
# removed again on a hard bounce or spam complaint. Both webhooks are rejected
# unless the request signature matches, so these must be set for the flow to work.
# Resend: Webhooks → add endpoint https://yourdomain.com/api/webhooks/email/resend
#   subscribed to email.delivered, email.bounced, email.complained.
RESEND_WEBHOOK_SECRET=whsec_your-resend-signing-secret
# MailerSend: Webhooks → add https://yourdomain.com/api/webhooks/email/mailersend
#   subscribed to activity.delivered, activity.hard_bounced, activity.spam_complaint.
MAILERSEND_WEBHOOK_SECRET=your-mailersend-signing-secret
