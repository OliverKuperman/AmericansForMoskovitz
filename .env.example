# Server
PORT=3000
SITE_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — Railway (or any provider that gives a connection string):
#   Set DATABASE_URL and leave the individual DB_* vars unset.
#   SSL is enabled automatically; override with DB_SSL=false if needed.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — individual connection params (local / self-hosted):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moskovitz_petition
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Set to "true" to enable SSL; "false" to force-disable even when DATABASE_URL is set.
DB_SSL=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Used to send email verification links when someone submits the petition.
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_ADDRESS="Site Name <noreply@yourdomain.com>"

# ── Email fallback (MailerSend) ──────────────────────────────────────────────
# Used automatically if Resend fails. Get an API key at https://app.mailersend.com
# and verify your sending domain there.
MAILERSEND_API_KEY=your-mailersend-api-key
